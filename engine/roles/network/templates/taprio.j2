# https://man7.org/linux/man-pages/man8/tc-taprio.8.html
#

qdisc replace dev {{ iface.value.name if iface.value.name is defined else iface }} parent root handle 100 taprio  \
      num_tc {{ qdisc.queues | length }}                                  \
      map
{%- set vars = { 'found': False} -%}
{% for item in priority_list -%}
  {%- if vars.update({'found': False}) -%}{%- endif -%}
  {%- for q in qdisc.queues | dict2items -%}
    {%- if item in q.value.prio %}
 {{(q.key | int)-1}}
      {%- if vars.update({'found': True}) -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if not vars.found %}
 {{queue_default}}
  {%- endif %}
{%- endfor %} \
      queues {{ [ '', '4@0', '2@0 2@2', '1@0 1@1 2@2', '1@0 1@1 1@2 1@3', '1@0 1@1 1@2 1@3 1@4'][qdisc.queues | length] }} \
      base-time 1605802187000000000          \
{% if qdisc.taprio.txtime is defined and qdisc.taprio.txtime %}
      flags 0x1                                                       \
      txtime-delay {{ qdisc.taprio.delay | default(tsn_txtime_delay) }} \
{% endif %}
{% for entry in qdisc.taprio.sched | default([]) %}
{% set hex_gates = [] %}
{% for q in entry.queue %}
{% set new_list2 = hex_gates.append( 2 | pow((q|int) - 1) | round | int ) %}
{% endfor %}
      sched-entry S {{ "%02x" | format( hex_gates | sum ) }} {{ entry.duration}}000 \
{% endfor %}
      clockid CLOCK_TAI
